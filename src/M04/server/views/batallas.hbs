<div class="text-center mb-12">
    <h1 class="text-5xl font-serif font-bold text-red-500 mb-4">Registro de Batallas Globales</h1>
    <div class="inline-block glass-panel px-8 py-4 rounded-full">
        <p class="text-xl">Total de batallas en el Servidor: <span class="text-3xl font-bold text-white ml-2">{{totalBattles}}</span></p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {{#if battles}}
        {{#each battles}}
        <div class="glass-panel p-6 rounded-xl border-l-4 {{#if (eq this.result 'victoria')}}border-green-500{{else if (eq this.result 'derrota')}}border-red-600{{else}}border-slate-500{{/if}} hover:bg-slate-800 transition transform hover:-translate-y-1 flex flex-col gap-3">

            {{!-- Cabecera: número + badge resultado --}}
            <div class="flex items-center justify-between">
                <h3 class="text-2xl font-bold">Batalla <span class="text-red-400">#{{this.num_battle}}</span></h3>
                {{#if (eq this.result 'victoria')}}
                    <span class="bg-green-700/60 text-green-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">⚔️ Victoria</span>
                {{else if (eq this.result 'derrota')}}
                    <span class="bg-red-800/60 text-red-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">💀 Derrota</span>
                {{else}}
                    <span class="bg-slate-700/60 text-slate-400 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">❓ Sin datos</span>
                {{/if}}
            </div>

            {{!-- Civilización y jugador --}}
            <div class="bg-slate-900/60 rounded-lg px-4 py-2 flex items-center gap-3">
                <span class="text-2xl">🏛️</span>
                <div>
                    <p class="text-white font-semibold leading-tight">{{this.civ_name}}</p>
                    <p class="text-slate-400 text-xs">Comandante: <span class="text-blue-400 font-medium">{{this.username}}</span></p>
                </div>
            </div>

            {{!-- Recursos obtenidos --}}
            <div class="flex gap-3 text-sm">
                <span class="bg-amber-900/40 text-amber-400 px-3 py-1 rounded flex-1 text-center">🪵 +{{this.wood_acquired}} madera</span>
                <span class="bg-gray-700/40 text-gray-300 px-3 py-1 rounded flex-1 text-center">🪨 +{{this.iron_acquired}} hierro</span>
            </div>

            {{!-- Bajas --}}
            <div class="flex gap-3 text-xs text-center">
                <div class="flex-1 bg-blue-900/30 rounded px-2 py-1">
                    <p class="text-slate-400 mb-0.5">Bajas propias</p>
                    <p class="text-blue-300 font-bold text-base">{{this.civ_drops}}</p>
                </div>
                <div class="flex-1 bg-red-900/30 rounded px-2 py-1">
                    <p class="text-slate-400 mb-0.5">Bajas enemigas</p>
                    <p class="text-red-300 font-bold text-base">{{this.enemy_drops}}</p>
                </div>
            </div>

            {{!-- Enlace al informe —— ahora pasa también civ --}}
            <a href="/informe?informe={{this.num_battle}}&civ={{this.civilization_id}}"
               class="block text-center bg-slate-700 hover:bg-red-700 text-white py-2 rounded-lg transition text-sm font-semibold mt-auto">
                📜 Leer Informe Detallado
            </a>
        </div>
        {{/each}}
    {{else}}
        <div class="col-span-3 text-center py-10 text-slate-500">No han habido batallas. La paz reina (de momento).</div>
    {{/if}}
</div>