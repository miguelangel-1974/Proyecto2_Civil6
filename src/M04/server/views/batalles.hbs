<!DOCTYPE html>
<html lang="ca">
<head>
  {{> header}}
  <link rel="stylesheet" href="/estils.css">
  <title>Civilizations - Batalles</title>
</head>
<body>
  {{> menu}}

  <main class="container">
    <h1>⚔️ Historial de Batalles</h1>

    <div class="card" style="text-align: center; margin-bottom: 20px;">
        <h2>Total de batalles jugades: <span class="destacat">{{totalBatalles}}</span></h2>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Data</th>
          <th>Resultat</th>
          <th>Enllaç</th>
        </tr>
      </thead>
      <tbody>
        {{#each batalles}}
          <tr>
            <td>{{id_batalla}}</td>
            <td>{{data}}</td>
            <td>{{resultat}}</td>
            <td><a href="/informe?informe={{id_batalla}}">📝 Informe</a></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </main>

  {{> footer}}
</body>
</html>