{{#if user}}
    <div class="text-center mb-10">
        <h1 class="text-4xl font-serif font-bold text-white">Bienvenido, Comandante <span class="text-blue-400">{{user.username}}</span></h1>
        <p class="text-slate-400 mt-2">Selecciona una de tus civilizaciones para ver los detalles.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#each civs}}
        <a href="/mi-ciudad/detalles/{{this.civilization_id}}" class="block glass-panel p-6 rounded-2xl border-t-4 border-blue-500 hover:bg-slate-800 transition transform hover:-translate-y-2 cursor-pointer">
            <h3 class="text-2xl font-bold text-white mb-4">{{this.name}}</h3>
            <div class="grid grid-cols-2 gap-2 text-sm mb-4">
                <span class="bg-slate-900 p-2 rounded text-green-400">🍞 {{this.food_amount}}</span>
                <span class="bg-slate-900 p-2 rounded text-amber-600">🪵 {{this.wood_amount}}</span>
                <span class="bg-slate-900 p-2 rounded text-gray-400">🪨 {{this.iron_amount}}</span>
                <span class="bg-slate-900 p-2 rounded text-purple-400">🔮 {{this.mana_amount}}</span>
            </div>
            <div class="text-right text-red-400 text-sm font-bold">
                ⚔️ Batallas: {{this.battles_counter}}
            </div>
        </a>
        {{/each}}
    </div>
{{else}}
    <div class="max-w-md mx-auto glass-panel p-8 rounded-2xl mt-10">
        <h1 class="text-3xl font-serif font-bold text-center text-white mb-8">Acceso al Centro de Mando</h1>
        
        {{#if error}}
        <div class="bg-red-900/50 border border-red-500 text-red-200 p-3 rounded mb-6 text-sm text-center">
            {{error}}
        </div>
        {{/if}}

        <form action="/mi-ciudad" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Usuario</label>
                <input type="text" name="username" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Contraseña</label>
                <input type="password" name="password" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition">
            </div>
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg transition shadow-lg shadow-blue-500/20">
                Entrar a mi Ciudad
            </button>
        </form>
    </div>
{{/if}}