<div class="mb-6 flex justify-between items-center">
    <h1 class="text-4xl font-serif font-bold text-white">Imperio: <span class="text-blue-400">{{stats.name}}</span></h1>
    <a href="/mi-ciudad" class="text-slate-400 hover:text-white transition">&larr; Volver a mis ciudades</a>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">
    <div class="glass-panel p-6 rounded-2xl border-t-4 border-green-500 text-center">
        <div class="text-4xl mb-2">🍞</div>
        <h3 class="text-sm uppercase text-slate-400 tracking-wider">Comida</h3>
        <p class="text-3xl font-bold text-white">{{stats.food_amount}}</p>
    </div>
    <div class="glass-panel p-6 rounded-2xl border-t-4 border-amber-700 text-center">
        <div class="text-4xl mb-2">🪵</div>
        <h3 class="text-sm uppercase text-slate-400 tracking-wider">Madera</h3>
        <p class="text-3xl font-bold text-white">{{stats.wood_amount}}</p>
    </div>
    <div class="glass-panel p-6 rounded-2xl border-t-4 border-gray-400 text-center">
        <div class="text-4xl mb-2">🪨</div>
        <h3 class="text-sm uppercase text-slate-400 tracking-wider">Hierro</h3>
        <p class="text-3xl font-bold text-white">{{stats.iron_amount}}</p>
    </div>
    <div class="glass-panel p-6 rounded-2xl border-t-4 border-purple-500 text-center">
        <div class="text-4xl mb-2">🔮</div>
        <h3 class="text-sm uppercase text-slate-400 tracking-wider">Maná</h3>
        <p class="text-3xl font-bold text-white">{{stats.mana_amount}}</p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
    <div class="glass-panel p-8 rounded-2xl">
        <h2 class="text-2xl font-serif mb-6 text-amber-400 border-b border-slate-700 pb-2">Infraestructura</h2>
        <ul class="space-y-4">
            <li class="flex justify-between items-center"><span class="text-lg">Granjas</span> <span class="bg-slate-800 px-4 py-1 rounded-full font-mono">{{stats.farm_counter}}</span></li>
            <li class="flex justify-between items-center"><span class="text-lg">Carpinterías</span> <span class="bg-slate-800 px-4 py-1 rounded-full font-mono">{{stats.carpentry_counter}}</span></li>
            <li class="flex justify-between items-center"><span class="text-lg">Herrerías</span> <span class="bg-slate-800 px-4 py-1 rounded-full font-mono">{{stats.smithy_counter}}</span></li>
            <li class="flex justify-between items-center"><span class="text-lg">Torres Mágicas</span> <span class="bg-slate-800 px-4 py-1 rounded-full font-mono">{{stats.magicTower_counter}}</span></li>
            <li class="flex justify-between items-center"><span class="text-lg">Iglesias</span> <span class="bg-slate-800 px-4 py-1 rounded-full font-mono">{{stats.church_counter}}</span></li>
        </ul>
    </div>
    
    <div class="glass-panel p-8 rounded-2xl">
        <h2 class="text-2xl font-serif mb-6 text-blue-400 border-b border-slate-700 pb-2">Tecnología y Progreso</h2>
        <ul class="space-y-4">
            <li class="flex justify-between items-center"><span class="text-lg">Nivel de Ataque</span> <span class="text-red-400 font-bold text-xl">Lvl {{stats.technology_attack_level}}</span></li>
            <li class="flex justify-between items-center"><span class="text-lg">Nivel de Defensa</span> <span class="text-blue-400 font-bold text-xl">Lvl {{stats.technology_defense_level}}</span></li>
            <li class="flex justify-between items-center pt-4 mt-4 border-t border-slate-700"><span class="text-lg font-bold">Batallas Libradas</span> <span class="text-white font-bold text-xl">{{stats.battles_counter}}</span></li>
        </ul>
    </div>
</div>

<div class="glass-panel p-8 rounded-2xl">
    <h2 class="text-2xl font-serif mb-6 text-red-500 border-b border-slate-700 pb-2">Fuerzas Militares</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
            <h3 class="text-xl text-slate-300 mb-4">Unidades Ofensivas</h3>
            {{#if atkUnits}}
                <ul class="space-y-2">
                    {{#each atkUnits}}
                    <li class="flex justify-between bg-slate-800/50 p-2 rounded px-4"><span>{{this.type}}</span> <span class="font-mono text-red-400">{{this.qty}}</span></li>
                    {{/each}}
                </ul>
            {{else}}
                <p class="text-slate-500 text-sm">No hay unidades de ataque reclutadas.</p>
            {{/if}}
        </div>
        <div>
            <h3 class="text-xl text-slate-300 mb-4">Unidades Defensivas</h3>
            {{#if defUnits}}
                <ul class="space-y-2">
                    {{#each defUnits}}
                    <li class="flex justify-between bg-slate-800/50 p-2 rounded px-4"><span>{{this.type}}</span> <span class="font-mono text-blue-400">{{this.qty}}</span></li>
                    {{/each}}
                </ul>
            {{else}}
                <p class="text-slate-500 text-sm">No hay defensas construidas.</p>
            {{/if}}
        </div>
    </div>
</div>